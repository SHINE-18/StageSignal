# StageSignal Environment Variables
# Copy to .env.local for local development

# Required: Convex Deployment URL
# Local development: set by `npx convex dev` (e.g. https://dev-name.convex.cloud)
# Production: set in Vercel project settings from `npx convex deploy`
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
